# AuroraOS Kconfig overlay: Cortex-M7 QEMU with the Lua VM enabled.
#
# Why this preset exists
# ----------------------
# CONFIG_LUA_VM defaults to n on every board except MiBand 8, and MiBand 8
# pulls its Lua sources directly from boards/xiaomi/miband8/board.cmake rather
# than through the generic root-CMake branch.  As a result the
# `CONFIG_LUA_VM && NOT miband8` path -- Lua sources appended in the root
# CMakeLists.txt, plus the Lua branches in apps/kernel.cpp, apps/shell.cpp and
# kernel/core/symbol_export.cpp -- is compiled by no CI job.
#
# The MPS2+ AN500 has 4 MB of RAM and is the least risky target on which to
# exercise that path.
#
# Used by the `kconfig-matrix` job:
#   cmake -DAURORA_KCONFIG_OVERLAY=config/presets/mps2-an500-lua-on.config ...
#
CONFIG_LUA_VM=y
